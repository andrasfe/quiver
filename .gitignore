# Hardware-experimentation notebooks: tracked in git but encrypted at
# rest via git-crypt (see .gitattributes). On github.com these files
# appear as binary blobs; locally they decrypt automatically once the
# repo is unlocked with the saved key.
.ipynb_checkpoints/
